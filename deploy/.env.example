# Copy to deploy/.env and set real values. NEVER commit deploy/.env.
DB_SA_PASSWORD=Change_this_Strong_Pass123
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=Change_this_admin_pass
MINIO_ROOT_USER=sms-minio
MINIO_ROOT_PASSWORD=Change_this_minio_pass
AUTH_AUTHORITY=https://auth.your-institution.edu/realms/sms
PUBLIC_URL=https://sms.your-institution.edu
MOODLE_URL=https://moodle.your-institution.edu
MOODLE_TOKEN=your-moodle-webservice-token

# Accounting integration (None | Sage300 | future: QuickBooks, Xero). HTTPS only.
ACCOUNTING_PROVIDER=None
SAGE_BASEURL=
SAGE_COMPANY=
SAGE_USER=
SAGE_PASSWORD=

# CRM: BuiltIn (default) or Webhook (push leads to any external system). No Mautic needed.
CRM_PROVIDER=BuiltIn
CRM_CAPTURE_SECRET=
CRM_WEBHOOK_URL=

# AI (OFF by default; enable only under data-protection approval). OpenAI-compatible endpoint.
AI_PROVIDER=None
AI_ENABLED=false
AI_BASEURL=
AI_MODEL=
# AI API key is added via the environment secret AI__ApiKey, never in source.
